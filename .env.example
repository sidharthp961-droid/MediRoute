# Server Configuration
PORT=3001

# Moderator Authentication
# Required secret key for dispatchers/moderators to review, verify or escalate emergency reports.
# Set a strong, unique secret key in your private, git-ignored .env file.
# Note: Never commit real credentials to version control.
MODERATOR_KEY=your_moderator_secret_key_here

# Client — set this to the LAN IP of the machine running the server
# For Laptop 2, change localhost to Laptop 1's LAN IP (e.g. 192.168.1.10)
VITE_SERVER_URL=http://localhost:3001
